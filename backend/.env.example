# Next.js sets NODE_ENV automatically. Scripts use port 3001.
DATABASE_MODE=pglite
PGLITE_PATH=.local/database
# Production: DATABASE_MODE=postgres and a PostgreSQL URL with verified TLS.
DATABASE_URL=
# Required in production; generate at least 32 random characters.
TOKEN_SECRET=
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:4194
TRUST_PROXY=false
# Required in production (true or false). Set true only behind a proxy that replaces X-Forwarded-For with the client IP.
# Without a trusted proxy, anonymous requests share one IP rate-limit bucket (its allowance is widened 20x).
# TRUST_PROXY_HOPS is how many trusted proxies sit in front of the app (default 1). The client address is
# taken that many entries from the RIGHT of X-Forwarded-For, so a client cannot choose it by sending the header.
TRUST_PROXY_HOPS=1
SMS_MODE=disabled
# SMS_MODE=console prints verification codes to the server terminal (development only).
# SMS_MODE=webhook uses POST {mobile,message,idempotencyKey} and bearer auth.
SMS_WEBHOOK_URL=
SMS_WEBHOOK_TOKEN=
# Password-reset codes by email. EMAIL_MODE: disabled | console (development only) | resend.
# EMAIL_FROM must use a domain verified in Resend, e.g. "CPR Medical Academy <no-reply@yourdomain.com>".
# Until a domain is verified, onboarding@resend.dev only delivers to the Resend account owner's inbox.
EMAIL_MODE=disabled
RESEND_API_KEY=
EMAIL_FROM=
# Temporary toggle: true skips OTP entry at signup (accounts go straight to
# awaiting_approval, logged in). Set to false to require phone verification again.
# While true, nobody proves they own the number they sign up with, and a repeat signup reveals
# that a number is already registered. Production refuses to start with it unless
# ACKNOWLEDGE_UNVERIFIED_MOBILES=true is also set.
SKIP_PHONE_VERIFICATION=false
# Image uploads (course posters etc.) go to Cloudinary when this is set; otherwise
# they're kept on local disk. Format: cloudinary://<api_key>:<api_secret>@<cloud_name>
CLOUDINARY_URL=
# Production: run npm run db:migrate before starting the web app.
# WORKER_MODE is required in production. The worker delivers SMS/email, finalises abandoned exams and cleans up.
#   embedded: the web process runs it (simplest: one container).
#   external: you run `node scripts/worker.js` (same image, same env) as a separate persistent service.
# GET /api/ready reports "worker": "ok" | "stale" | "unknown"; alert on anything but ok.
WORKER_MODE=embedded
