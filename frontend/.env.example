# Copy to .env.local for local development. On Vercel set these under
# Settings → Environment Variables. Only VITE_-prefixed vars reach the browser,
# and everything here IS public once built — never put a secret in this file.

# Leave this UNSET on Vercel. The app then calls the same-origin /api prefix, and
# vercel.json forwards /api/* to the backend project. Same-origin matters: the backend
# hands out relative links such as /api/content/<token> for lesson videos and notes.
# Only set it (to the backend origin plus /api) if you serve the frontend elsewhere.
# VITE_API_BASE_URL=https://api.cprmedicalacademy.com/api

# WhatsApp number for the floating chat bubble, digits only, country code first.
VITE_WHATSAPP_NUMBER=8801898938981

# Path of the staff (admin) sign-in page, without the leading slash. Pick something hard to
# guess, e.g. cpr-staff-7x9k2q. It is not a secret on its own (it ships in the JS bundle); the
# access key the page asks for (backend ADMIN_GATE_KEY) is what protects it. Default: staff-access
# VITE_ADMIN_GATE_PATH=staff-access
